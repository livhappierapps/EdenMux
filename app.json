{
  "expo": {
    "name": "EdenMux",
    "slug": "edenmux",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "edenmux",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#8b0a1a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.edenmux",
      "usesAppleSignIn": true,
      "buildNumber": "2",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "EdenMux uses your microphone so you can speak directly to Eden hands-free.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.edenmux",
      "versionCode": 2,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#8b0a1a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-media-library",
        {
          "photosPermission": "EdenMux saves App Store screenshots to your Camera Roll.",
          "savePhotosPermission": "EdenMux saves App Store screenshots to your Camera Roll.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/fab54c51-dc11-48fc-be0b-68f8619ee11e"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": "https://replit.com/"
      },
      "eas": {
        "projectId": "fab54c51-dc11-48fc-be0b-68f8619ee11e"
      },
      "appStoreId": "6761677068"
    },
    "owner": "livhappierapps"
  }
}
