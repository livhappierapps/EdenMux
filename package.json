{
  "name": "expo-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "patch-package",
    "eas-build-post-install": "patch-package",
    "expo:dev": "EXPO_PACKAGER_PROXY_URL=https://$REPLIT_DEV_DOMAIN REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN:5000 npx expo start --localhost --clear",
    "server:dev": "NODE_ENV=development tsx server/index.ts",
    "expo:start:static:build": "npx expo start --no-dev --minify --localhost",
    "expo:static:build": "node scripts/build.js",
    "server:build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=server_dist",
    "server:prod": "NODE_ENV=production node server_dist/index.js",
    "test:smoke": "node scripts/health-smoke.mjs",
    "test:eden-entitlement": "node --import tsx --test server/revenuecat.test.ts",
    "test:shell": "node --import tsx --test server/shell.test.ts",
    "test:security-education": "node --import tsx --test server/security-education.test.ts",
    "start": "npx expo start",
    "check:themes": "tsx scripts/check-theme-assets.ts",
    "lint": "npx expo lint",
    "lint:fix": "npx expo lint --fix",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "update:rollback": "eas update:republish --destination-channel production --group",
    "version:bump": "node scripts/version-bump.js",
    "version:bump:minor": "node scripts/version-bump.js minor",
    "version:bump:major": "node scripts/version-bump.js major",
    "version:check": "node scripts/check-version.js"
  },
